        <mxCell id="obs-monarch" parent="obs-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=13;align=center;spacingLeft=15;strokeWidth=2;" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Monarch (Distributed Time-Series Monitoring)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;• Local RAM Collectors per Borg Cell (Sub-ms write)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;• Global Query Engine for real-time anomaly spikes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;• Zero network bottleneck on Prod services&lt;/font&gt;&lt;/div&gt;" vertex="1">
